# Porta do servidor (backend)
PORT=3001

# URL do NTRIP Caster
NTRIP_CASTER_URL=http://170.84.40.52:2101

# Domínios permitidos pelo CORS (separados por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# TTL do cache em milissegundos
CACHE_TTL_MS=300000

# Ambiente (development/production)
NODE_ENV=development

# TTL do cache IBGE (milissegundos). Padrão: 3600000 (1 hora)
IBGE_CACHE_TTL=3600000

# URL base da API RBMC (IBGE)
# RBMC_API_BASE_URL=https://servicodados.ibge.gov.br/api/v1/rbmc

# Redis (opcional) para cache compartilhado entre múltiplas instâncias
# REDIS_URL=redis://localhost:6379

# Intervalo de re-broadcast para clientes SSE (milissegundos)
STATION_REFRESH_MS=60000
